# Copy to .env and fill in. Never commit real values.

# Scraper (FR-1). Required: an identifiable bot name with a contact address.
SCRAPER_USER_AGENT="IQM-RAG-Assignment-Bot/0.1 (contact: you@example.com)"
# Minimum seconds between requests. The crawl uses the larger of this and robots.txt Crawl-delay.
SCRAPER_DELAY_SECONDS=2.0

# OpenAI (embeddings now, answer generation later). Create a key in the OpenAI dashboard.
OPENAI_API_KEY=sk-your-key-here
# Embedding model used to build and query the index. Changing it requires re-indexing.
EMBEDDING_MODEL=text-embedding-3-large
# OpenAI chat model that writes the answers.
CHAT_MODEL=gpt-4.1-mini
# Model that rewrites follow-up questions into standalone queries. Defaults to CHAT_MODEL.
# REWRITE_MODEL=gpt-4.1-mini
# How many chunks are retrieved per question (1-50). Default 8.
RETRIEVAL_TOP_K=8

# Tracing with LangSmith (optional). Tracing is on whenever a key is set; leave it unset to run without tracing.
# Create a key at smith.langchain.com. Traces hold the questions and answers, so set the two HIDE flags to true to keep
# inputs and outputs out of LangSmith.
LANGSMITH_API_KEY=ls-your-key-here
# LANGSMITH_PROJECT=iqm-help-center-rag
# LANGSMITH_TRACING=false          # set to false to turn tracing off even with a key
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for an EU-region account
