# Copy to .env and fill in. Never commit real values.

# Scraper (FR-1). Required: an identifiable bot name with a contact address.
SCRAPER_USER_AGENT="IQM-RAG-Assignment-Bot/0.1 (contact: you@example.com)"
# Minimum seconds between requests. The crawl uses the larger of this and robots.txt Crawl-delay.
SCRAPER_DELAY_SECONDS=2.0

# LLM, embedding and tracing credentials are added here once those choices are made.
